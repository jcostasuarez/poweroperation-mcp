# Configuración de poweroperation-mcp. Copiar como ".env" junto al .exe (todo es opcional).

# --- CtAPI (runtime) ---
# Ruta a CtApi.dll o a su carpeta. Vacío = búsqueda automática en Program Files.
# Ej.: C:\Program Files (x86)\Schneider Electric\Power Operation\v2022\Bin\Bin (x64)
POWEROP_CTAPI=
# Equipo SCADA remoto (vacío = este equipo). Para remoto: [CtAPI] Remote=1 en el citect.ini del servidor.
POWEROP_HOST=
# Usuario/contraseña de un usuario del proyecto (obligatorio para conexión remota).
POWEROP_USER=
POWEROP_PASSWORD=
# Cluster por defecto (solo si hay más de uno).
POWEROP_CLUSTER=
# Segundos máximos por llamada.
POWEROP_TIMEOUT_SECS=30

# --- Proyecto (offline) ---
# Carpeta(s) User o de proyecto, separadas por ';'. Vacío = búsqueda automática en ProgramData.
POWEROP_PROJECTS_DIR=
# Proyecto por defecto (si no, el que figura en [CtEdit] Run= del citect.ini).
POWEROP_PROJECT=

# --- Alarmas por ODBC (alarm_sql) ---
POWEROP_ALARM_HOST=127.0.0.1
POWEROP_ALARM_PORT=5482
# SystemsXml propio (opcional; si no, se genera uno con host/puerto).
POWEROP_ALARM_SYSTEMS_XML=

# --- Seguridad ---
# 1 = permite tag_write, alarm_ack, Cicode con efectos y cicode_write. Por defecto: solo lectura.
POWEROP_ALLOW_WRITE=0
# Log de auditoría de escrituras (por defecto junto al exe).
POWEROP_AUDIT_LOG=
# Nivel de log a stderr: error, warn, info, debug.
POWEROP_MCP_LOG=info
