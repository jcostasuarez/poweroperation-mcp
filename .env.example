# Configuración de poweroperation-mcp. Copiar como ".env" junto al .exe (todo es opcional).

# --- CtAPI (runtime) ---
# Ruta a CtApi.dll o a su carpeta. Vacío = búsqueda automática en Program Files.
# Ej.: C:\Program Files (x86)\Schneider Electric\Power Operation\v2022\Bin\Bin (x64)
POWEROP_CTAPI=
# Equipo SCADA remoto (vacío = este equipo). Para remoto: [CtAPI] Remote=1 en el citect.ini del servidor.
POWEROP_HOST=
# Usuario/contraseña de un usuario del proyecto (obligatorio para conexión remota).
POWEROP_USER=
POWEROP_PASSWORD=
# Cluster por defecto (solo si hay más de uno).
POWEROP_CLUSTER=
# Segundos máximos por llamada.
POWEROP_TIMEOUT_SECS=30

# --- Proyecto (offline) ---
# Carpeta(s) User o de proyecto, separadas por ';'. Vacío = búsqueda automática en ProgramData.
POWEROP_PROJECTS_DIR=
# Proyecto por defecto (si no, el que figura en [CtEdit] Run= del citect.ini).
POWEROP_PROJECT=

# --- Alarmas por ODBC (po_alarm_sql) ---
# Vacíos = el servidor de alarmas del proyecto (tablas almsrv/netaddr, DBPORT) o localhost:5482.
# Las direcciones locales (127.0.0.1, ::1, nombre del equipo) se usan como "localhost" (PO 2024 escucha en ::1).
POWEROP_ALARM_HOST=
POWEROP_ALARM_PORT=
# SystemsXml propio (opcional; si no, se genera uno con el servidor de arriba).
POWEROP_ALARM_SYSTEMS_XML=
# Nombre del sistema dentro de ese SystemsXml (solo con POWEROP_ALARM_SYSTEMS_XML).
POWEROP_ALARM_SYSTEM=

# --- PLC por Modbus TCP (po_plc_read, solo lectura) ---
# nombre=host[:puerto][/unidad], varios separados por ';'. Puerto 502 y unidad 255 por defecto.
# Ej.: POWEROP_MODBUS=PLC1=192.0.2.10:502/255
POWEROP_MODBUS=

# --- Puentes ---
# Cada cuántos segundos se vuelve a sondear CtAPI, ODBC y Modbus para mostrar/ocultar herramientas (0 = nunca).
POWEROP_PROBE_SECS=30

# --- Seguridad ---
# 1 = habilita (y lista) las herramientas de escritura: po_tag_write, po_alarm_ack, Cicode con efectos,
# po_cicode_write, po_project_create/rows_add/rows_update/compile, po_gb_page_*, po_runtime_control.
# Por defecto: solo lectura.
POWEROP_ALLOW_WRITE=0
# Páginas de librerías de PO (PLS_Include, Include...) que po_gb_page_edit puede modificar, separadas por ';'.
# Solo páginas exactas (Proyecto/Página, sin comodines). Ojo: esas librerías las usan todos los proyectos del equipo.
# Ej.: POWEROP_GB_ALLOW_PAGES=PLS_Include/!equipment1
POWEROP_GB_ALLOW_PAGES=
# Log de auditoría de escrituras (por defecto junto al exe).
POWEROP_AUDIT_LOG=
# Nivel de log a stderr: error, warn, info, debug.
POWEROP_MCP_LOG=info
